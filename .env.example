# ==============================================================================
# RGMCET AIML Academic Schedule Management System (ASMS)
# Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
TZ=Asia/Kolkata

# Security & Authentication
# In production (NODE_ENV=production), JWT_SECRET is MANDATORY and must be >= 32 characters.
JWT_SECRET=change_me_to_a_cryptographically_secure_random_key_min_32_characters

# Reverse Proxy Trust (1 for single reverse proxy such as Nginx; 0 if direct)
TRUST_PROXY=1

# Allowed CORS Origins (comma-separated list; leave empty for same-origin only)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Database Storage Path (relative to project root or absolute path)
DB_PATH=server/data/academic.db

# SMS Gateway Integration (options: console | msg91 | fast2sms | none)
# In development, 'console' prints OTP to stdout.
# In production, set to a configured gateway or 'none' (which informs user to contact admin).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# Initial Administrator Password (used only when seeding an empty database)
# If left empty, a secure fallback is generated and logged once.
ADMIN_INITIAL_PASSWORD=
